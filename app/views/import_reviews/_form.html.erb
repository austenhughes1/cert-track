<%# locals: (item:, fields:, crew_members:, certificate_types:, certificate_issuers:, merge_candidates:) %>
<%# The proposal, editable. Accept (POST accept) turns it into a certificate; "Save edits"
    sends the same fields as PATCH to update; Merge (POST merge) makes one certificate from
    this item and its front/back partners. The form carries the session's CSRF token, not a
    per-form one, since a per-form token would only be good for Accept's URL. The
    review-expiry controller keeps the expiry hint in step with the type and completion date.
    The issuer picker's "Other…" adds an issuer when the form is accepted or saved. %>
<% input_class = "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-600 focus:outline-none focus:ring-1 focus:ring-blue-600" %>
<% hint_class = "mt-1 text-xs text-gray-500" %>

<% people = crew_members.map { |member| [ member.sort_name, member.id ] } %>
<% if (member = item.matched_crew_member) && crew_members.exclude?(member) %>
  <% people.unshift([ "#{member.sort_name} (inactive)", member.id ]) %>
<% end %>
<% type_label = ->(type) { "#{type.name} (#{type.code}) · #{type.never_expires? ? "never expires" : "valid #{pluralize(type.validity_months, "month")}"}" } %>
<% types = certificate_types.dup %>
<% types.unshift(item.matched_certificate_type) if item.matched_certificate_type && types.exclude?(item.matched_certificate_type) %>
<% type_choices = types.map { |type| [ type_label.call(type), type.id, import_type_option_attributes(type) ] } %>
<% selected_type = types.find { |type| type.id == fields.certificate_type_id.presence&.to_i } %>
<% completed_on = (Date.iso8601(fields.completed_on.to_s) rescue nil) %>
<% unreadable_expiry = item.unreadable_expires_on %>
<% expiry_missing = unreadable_expiry.present? && fields.expires_on.blank? %>
<% expiry_class = expiry_missing ? input_class.sub("border-gray-300", "border-red-400 bg-red-50") : input_class %>

<section class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm" aria-labelledby="proposal_heading">
  <h2 id="proposal_heading" class="text-sm font-semibold text-gray-900">Certificate to create</h2>

  <%= form_with model: fields, scope: :review, url: accept_import_review_path(item), method: :post, id: "review_form",
        authenticity_token: form_authenticity_token, data: { controller: "review-expiry" }, class: "mt-3 space-y-4" do |form| %>
    <div>
      <div class="flex items-center justify-between gap-2">
        <%= form.label :crew_member_id, "Crew member", class: "block text-sm font-medium text-gray-700" %>
        <%= import_match_badge(import_person_match_state(item)) %>
      </div>
      <%= form.select :crew_member_id,
            import_picker_options(suggestions: item.person_suggestions, records: people, selected_id: fields.crew_member_id),
            { include_blank: "Choose a person" }, required: true, class: "#{input_class} bg-white" %>
      <p class="<%= hint_class %>">
        <% if item.person_unmatched? && item.person_suggestions.blank? %>
          Nobody on the crew list matches “<%= item.holder_name_raw %>”.
          <a href="#new_crew_member" class="text-blue-700 hover:underline">Create a crew member from this</a>, or pick someone.
        <% else %>
          Suggestions come first, best match on top; the rest of the active crew follows.
        <% end %>
      </p>
    </div>

    <div>
      <div class="flex items-center justify-between gap-2">
        <%= form.label :certificate_type_id, "Certificate type", class: "block text-sm font-medium text-gray-700" %>
        <%= import_match_badge(item.type_match) %>
      </div>
      <%= form.select :certificate_type_id,
            import_picker_options(suggestions: item.type_suggestions, records: type_choices, selected_id: fields.certificate_type_id),
            { include_blank: "Choose a type" }, required: true, class: "#{input_class} bg-white",
            data: { review_expiry_target: "type", action: "change->review-expiry#update" } %>
      <% if can?(:admin) %>
        <p class="<%= hint_class %>">Missing a type? <%= link_to "Add it to the master list", new_certificate_type_path, class: "text-blue-700 hover:underline", target: "_blank" %>.</p>
      <% end %>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :completed_on, "Completed on", class: "block text-sm font-medium text-gray-700" %>
        <%= form.date_field :completed_on, required: true, max: Date.current, class: input_class,
              data: { review_expiry_target: "completed", action: "input->review-expiry#update change->review-expiry#update" } %>
      </div>
      <div>
        <%= form.label :expires_on, class: "block text-sm font-medium text-gray-700" do %>
          Expires on<% if unreadable_expiry %> <span class="text-red-700">(required)</span><% end %>
        <% end %>
        <%= form.date_field :expires_on, required: unreadable_expiry.present?, class: expiry_class,
              aria: { describedby: unreadable_expiry ? "review_expires_on_unreadable" : "review_expires_on_hint", invalid: ("true" if expiry_missing) } %>
      </div>
    </div>
    <% if unreadable_expiry %>
      <%# Imports::Accept refuses a blank expiry here: computing one would hide the date on the card. %>
      <p id="review_expires_on_unreadable" class="-mt-2 text-xs font-medium <%= expiry_missing ? "text-red-700" : "text-gray-600" %>"
         <%= tag.attributes(role: ("alert" if expiry_missing)) %>>
        The card's expiry ("<%= unreadable_expiry %>") could not be read. Type the expiry date from the card.
      </p>
    <% else %>
      <p id="review_expires_on_hint" class="-mt-2 text-xs text-gray-500">
        Use the date printed on the card. Leave it blank to work it out from the type<span data-review-expiry-target="rule"><%= import_expiry_rule(selected_type, completed_on) %></span>
      </p>
    <% end %>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :certificate_number, "Certificate or card number", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :certificate_number, autocomplete: "off", class: "#{input_class} font-mono" %>
      </div>
      <%# The issuer's name as the AI read it; the picker below is the issuer. %>
      <% if fields.issued_by.present? || item.issuer_raw.present? %>
        <div>
          <%= form.label :issued_by, "Issuer as printed", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :issued_by, autocomplete: "off", class: input_class %>
        </div>
      <% end %>
    </div>

    <%= render "shared/issuer_picker", form: form, issuers: certificate_issuers, selected: fields.certificate_issuer_id,
          current: item.matched_certificate_issuer, other_name: fields.other_issuer_name,
          suggestions: item.issuer_suggestions, badge: import_match_badge(item.issuer_match), input_class: input_class %>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :verification_code, "Verification code", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :verification_code, autocomplete: "off", spellcheck: false, class: "#{input_class} font-mono",
              aria: { describedby: "review_verification_code_hint" } %>
        <p id="review_verification_code_hint" class="<%= hint_class %>">What goes into the issuer's lookup page.</p>
      </div>
      <div>
        <%= form.label :verification_url, "Verification link", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :verification_url, autocomplete: "off", spellcheck: false, inputmode: "url", placeholder: "https://",
              class: input_class, aria: { describedby: "review_verification_url_hint" } %>
        <p id="review_verification_url_hint" class="<%= hint_class %>">From the QR code or printed address.</p>
      </div>
    </div>

    <% merge_candidates.each do |other| %>
      <%= hidden_field_tag "other_ids[]", other.id, id: nil %>
    <% end %>

    <div class="flex flex-wrap items-center gap-2 border-t border-gray-100 pt-4">
      <%= form.button "Accept", type: "submit", title: "Shortcut: A", data: { review_shortcuts_target: "accept", turbo_submits_with: "Accepting…" },
            class: "cursor-pointer rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 disabled:cursor-wait disabled:opacity-60" %>
      <%= form.button "Save edits", type: "submit", name: "_method", value: "patch", formaction: import_review_path(item), formnovalidate: true,
            title: "Keep your changes without accepting; it stays in the queue",
            class: "cursor-pointer rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" %>
    </div>

    <% if merge_candidates.any? %>
      <div class="rounded-md border border-sky-200 bg-sky-50 px-3 py-3 text-sm text-sky-900" id="merge_candidates">
        <p>
          <%= merge_candidates.size == 1 ? "Another item has" : "#{merge_candidates.size} other items have" %>
          the same person, type and number, probably the other side of this card:
        </p>
        <ul class="mt-1 list-disc pl-5">
          <% merge_candidates.each do |other| %>
            <li>
              <%= link_to [ other.original_filename.presence || "Item #{other.id}", import_page_label(other) ].compact.join(" "),
                    import_review_path(other), class: "text-blue-700 hover:underline", target: "_blank" %>
            </li>
          <% end %>
        </ul>
        <%= form.button "Merge with #{pluralize(merge_candidates.size, "matching item")} (front/back of one card)", type: "submit",
              formaction: merge_import_review_path(item), id: "merge_button",
              class: "mt-2 cursor-pointer rounded-md border border-sky-300 bg-white px-3 py-1.5 text-sm font-medium text-sky-800 shadow-sm hover:bg-sky-100" %>
      </div>
    <% end %>
  <% end %>
</section>
