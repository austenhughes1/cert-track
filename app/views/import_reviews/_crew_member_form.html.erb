<%# locals: (item:, attributes:, errors:, crew_roles:, employers:) %>
<%# "Create crew member from this": prefilled from the name on the card. Opens by itself when
    nobody matched, or when the last attempt had errors. %>
<% input_class = "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-600 focus:outline-none focus:ring-1 focus:ring-blue-600" %>
<% attributes = (attributes || {}).to_h.symbolize_keys %>
<% open = errors.any? || (item.person_unmatched? && item.person_suggestions.blank?) %>

<details id="new_crew_member" class="rounded-lg border border-gray-200 bg-white shadow-sm" <%= "open" if open %>>
  <summary class="cursor-pointer px-4 py-3 text-sm font-semibold text-gray-900">Create crew member from this</summary>
  <%= form_with url: create_crew_member_import_review_path(item), scope: :crew_member, id: "crew_member_form",
        class: "space-y-4 border-t border-gray-100 px-4 py-4" do |form| %>
    <% if errors.any? %>
      <div class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800" role="alert" id="crew_member_errors">
        <ul class="list-disc space-y-1 pl-5">
          <% errors.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <p class="text-xs text-gray-500">
      Adds them to the crew list and picks them for this certificate. Accept it afterwards as usual.
    </p>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :first_name, class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :first_name, value: attributes[:first_name], required: true, autocomplete: "off", class: input_class %>
      </div>
      <div>
        <%= form.label :last_name, class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :last_name, value: attributes[:last_name], required: true, autocomplete: "off", class: input_class %>
      </div>
      <div>
        <%= form.label :employer, class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :employer, value: attributes[:employer], autocomplete: "off", placeholder: "ABA Ventures or a subcontractor",
              list: "crew_employers", class: input_class %>
      </div>
      <div>
        <%= form.label :crew_role_id, "Role", class: "block text-sm font-medium text-gray-700" %>
        <%= form.select :crew_role_id, options_from_collection_for_select(crew_roles, :id, :name, attributes[:crew_role_id].presence&.to_i),
              { include_blank: "No role" }, class: "#{input_class} bg-white" %>
      </div>
    </div>
    <datalist id="crew_employers">
      <% employers.each do |employer| %>
        <option value="<%= employer %>"></option>
      <% end %>
    </datalist>
    <%= form.submit "Create crew member and pick them", name: nil,
          class: "cursor-pointer rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" %>
  <% end %>
</details>
