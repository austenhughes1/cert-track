<% content_for :title, "Review queue" %>

<%= link_to "← Imports", imports_path, class: "text-sm text-blue-700 hover:underline" %>

<div class="mt-2 mb-4 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold">Review queue</h1>
    <p class="mt-1 text-sm text-gray-500" id="review_counts">
      <%= pluralize(@total_count, "item") %> waiting for review<% if @skipped_count.positive? %>, <%= @skipped_count %> of them skipped once<% end %>.
      <% if @processing_count.positive? %>
        <%= pluralize(@processing_count, "more item") %> still being read.
      <% end %>
    </p>
  </div>
  <% if @items.any? %>
    <%= link_to "Start reviewing", import_review_path(@items.first), id: "start_reviewing",
          class: "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-center text-sm font-semibold text-gray-800 shadow-sm hover:bg-gray-50 sm:w-auto" %>
  <% end %>
</div>

<% if @ready_count.to_i.positive? %>
  <section class="mb-4 flex flex-col gap-3 rounded-lg border border-green-200 bg-green-50 p-4 sm:flex-row sm:items-center sm:justify-between" id="accept_all" aria-label="Accept all">
    <p class="text-sm text-green-900">
      <span class="font-semibold"><%= pluralize(@ready_count, "certificate") %> ready to accept:</span>
      read at <%= number_to_percentage(Imports::Config.auto_accept_confidence.to_f * 100, precision: 0) %> confidence or higher, with everything matched and nothing flagged.
    </p>
    <%= button_to "Accept all #{@ready_count}", accept_all_import_reviews_path, id: "accept_all_button",
          form: { data: { turbo_confirm: "Accept #{pluralize(@ready_count, "certificate")} without opening each one?" } },
          class: "w-full cursor-pointer whitespace-nowrap rounded-md bg-green-700 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-green-600 sm:w-auto sm:py-2" %>
  </section>
<% end %>

<% if @items.empty? %>
  <div class="rounded-lg border border-dashed border-gray-300 bg-white px-6 py-12 text-center">
    <p class="text-sm font-medium text-gray-900">Nothing to review</p>
    <p class="mt-1 text-sm text-gray-500">
      <% if @processing_count.positive? %>
        Items appear here as the AI finishes reading them.
      <% else %>
        <%= link_to "Import more certificates", imports_path, class: "text-blue-700 hover:underline" %> and the ones that need a person's check show up here.
      <% end %>
    </p>
  </div>
<% else %>
  <% if @total_count > @items.size %>
    <p class="mb-2 text-sm text-gray-500">Showing the first <%= @items.size %> of <%= number_with_delimiter(@total_count) %>.</p>
  <% end %>
  <%# Cards on a phone, where the table would need sideways scrolling. %>
  <ul class="space-y-3 md:hidden" id="review_cards">
    <% @items.each do |item| %>
      <% blockers = @blockers.fetch(item.id) %>
      <li>
        <%= link_to import_review_path(item), class: "block rounded-lg border border-gray-200 bg-white p-4 shadow-sm active:bg-gray-50", data: { review_card: item.id } do %>
          <div class="flex items-start justify-between gap-3">
            <span class="min-w-0 font-medium text-gray-900 break-words"><%= item.matched_crew_member&.display_name || item.holder_name_raw.presence || "Name not read" %></span>
            <span class="shrink-0 text-sm"><%= import_confidence(item.confidence) %></span>
          </div>
          <p class="mt-1 text-sm text-gray-700 break-words"><%= item.matched_certificate_type&.name || item.certificate_name_raw.presence || "Certificate not read" %></p>
          <p class="mt-1 text-xs text-gray-500 break-words">
            Completed <%= format_date(item.proposed_completed_on) %> · <%= item.original_filename.presence || "Item #{item.id}" %>
            <% if item.skipped_at %><span class="text-amber-700">· skipped</span><% end %>
          </p>
          <p class="mt-2 flex flex-wrap items-center gap-1">
            <% if blockers.empty? %>
              <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-800" data-ready>Ready to accept</span>
            <% else %>
              <span class="text-xs text-amber-800" data-needs-look><%= blockers.first %></span>
            <% end %>
            <% if item.quality_flagged? %>
              <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800">Hard to read</span>
            <% end %>
          </p>
        <% end %>
      </li>
    <% end %>
  </ul>
  <div class="hidden overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm md:block">
    <table class="min-w-full divide-y divide-gray-200 text-sm" id="review_items">
      <thead class="bg-gray-50 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
        <tr>
          <th scope="col" class="px-4 py-2">File</th>
          <th scope="col" class="px-4 py-2">Name on card</th>
          <th scope="col" class="px-4 py-2">Person</th>
          <th scope="col" class="px-4 py-2">Certificate type</th>
          <th scope="col" class="px-4 py-2">Completed</th>
          <th scope="col" class="px-4 py-2 text-right">Confidence</th>
          <th scope="col" class="px-4 py-2">Batch</th>
          <th scope="col" class="px-4 py-2"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @items.each do |item| %>
          <tr id="<%= dom_id(item) %>" class="align-top hover:bg-gray-50">
            <td class="max-w-xs px-4 py-2">
              <span class="block break-all text-gray-900"><%= item.original_filename.presence || "Item #{item.id}" %></span>
              <span class="text-xs text-gray-500">
                <%= import_page_label(item) %>
                <% if item.skipped_at %><span class="text-amber-700">· skipped</span><% end %>
              </span>
            </td>
            <td class="px-4 py-2 text-gray-700"><%= item.holder_name_raw.presence || tag.span("—", class: "text-gray-400") %></td>
            <td class="whitespace-nowrap px-4 py-2">
              <% if item.matched_crew_member %>
                <%= item.matched_crew_member.display_name %>
              <% end %>
              <%= import_match_badge(import_person_match_state(item)) %>
              <% if item.quality_flagged? %>
                <span class="ml-1 inline-flex items-center whitespace-nowrap rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800" title="<%= item.quality_sentences.join(" ") %>" data-quality-flag>Hard to read</span>
              <% end %>
            </td>
            <td class="px-4 py-2">
              <% if item.matched_certificate_type %>
                <%= item.matched_certificate_type.name %>
              <% elsif item.certificate_name_raw.present? %>
                <span class="text-gray-500"><%= item.certificate_name_raw %></span>
              <% end %>
              <%= import_match_badge(item.type_match) %>
            </td>
            <td class="whitespace-nowrap px-4 py-2 text-gray-700"><%= format_date(item.proposed_completed_on) %></td>
            <td class="whitespace-nowrap px-4 py-2 text-right">
              <%= import_confidence(item.confidence) %>
              <% if @blockers.fetch(item.id).empty? %>
                <span class="mt-1 block text-xs font-medium text-green-700" data-ready>Ready</span>
              <% else %>
                <span class="mt-1 block max-w-40 whitespace-normal text-left text-xs text-amber-800" data-needs-look><%= @blockers.fetch(item.id).first %></span>
              <% end %>
            </td>
            <td class="whitespace-nowrap px-4 py-2">
              <%= link_to "##{item.import_batch_id}", import_path(item.import_batch_id), class: "text-blue-700 hover:underline",
                    aria: { label: "Batch #{item.import_batch_id}" } %>
            </td>
            <td class="whitespace-nowrap px-4 py-2 text-right">
              <%= link_to "Review", import_review_path(item), class: "font-medium text-blue-700 hover:underline",
                    aria: { label: "Review #{item.original_filename}" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
