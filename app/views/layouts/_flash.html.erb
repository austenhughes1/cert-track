<% if notice.present? %>
  <p class="mb-4 rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800" role="status"><%= notice %></p>
<% end %>
<% if alert.present? %>
  <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"><%= alert %></p>
<% end %>
