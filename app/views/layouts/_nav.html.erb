<%# Top navigation. Add a link here when a new top-level screen ships. %>
<% nav_link = ->(label, path, active) {
  link_to label, path, class: [
    "rounded-md px-3 py-2 text-sm font-medium",
    active ? "bg-gray-900 text-white" : "text-gray-300 hover:bg-gray-700 hover:text-white"
  ]
} %>
<nav class="bg-gray-800">
  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-1">
      <%= link_to "CertTrack", root_path, class: "mr-4 text-base font-semibold text-white" %>
      <%= nav_link.call "Dashboard", root_path, current_page?(root_path) %>
      <%= nav_link.call "Crew", crew_members_path, controller_path.in?(%w[crew_members certificates crew_roles]) %>
      <%= nav_link.call "Projects", projects_path, controller_path.start_with?("project") || controller_path.in?(%w[compliance packets]) %>
      <%= nav_link.call "Master list", certificate_types_path, controller_path == "certificate_types" %>
      <% if can?(:admin) %>
        <%= nav_link.call "Issuers", certificate_issuers_path, controller_path == "certificate_issuers" %>
      <% end %>
      <% if can?(:editor) %>
        <%= nav_link.call "Imports", imports_path, controller_path.in?(%w[imports import_reviews]) %>
      <% end %>
      <%= nav_link.call "Ask", ask_path, controller_path == "ask" %>
      <% if can?(:admin) %>
        <%= nav_link.call "Users", users_path, controller_path == "users" %>
        <%= nav_link.call "Jobs", "/jobs", false %>
      <% end %>
    </div>
    <div class="flex items-center gap-3 text-sm text-gray-300">
      <span><%= Current.user.display_name %> · <%= Current.user.role.humanize %></span>
      <%= button_to "Sign out", session_path, method: :delete, class: "rounded-md px-3 py-1.5 hover:bg-gray-700 hover:text-white" %>
    </div>
  </div>
</nav>
