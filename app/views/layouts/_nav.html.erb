<%# Top navigation. Add a link here when a new top-level screen ships. On a phone the links fold into
    a menu (a <details>, so no JavaScript), which closes by itself as each page loads. %>
<% links = [
  [ "Dashboard", root_path, current_page?(root_path) ],
  [ "Crew", crew_members_path, controller_path.in?(%w[crew_members certificates crew_roles]) ],
  [ "Projects", projects_path, controller_path.start_with?("project") || controller_path.in?(%w[compliance packets]) ],
  [ "Certificate types", certificate_types_path, controller_path == "certificate_types" ],
  ([ "Issuers", certificate_issuers_path, controller_path == "certificate_issuers" ] if can?(:admin)),
  ([ "Imports", imports_path, controller_path.in?(%w[imports import_reviews]) ] if can?(:editor)),
  [ "Ask", ask_path, controller_path == "ask" ],
  ([ "Users", users_path, controller_path == "users" ] if can?(:admin)),
  ([ "Jobs", "/jobs", false ] if can?(:admin))
].compact %>
<nav class="bg-gray-800">
  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-1">
      <%= link_to "CertTrack", root_path, class: "mr-4 text-base font-semibold text-white" %>
      <div class="hidden items-center gap-1 xl:flex" id="nav_links">
        <% links.each do |label, path, active| %>
          <%= link_to label, path, class: [ "whitespace-nowrap rounded-md px-3 py-2 text-sm font-medium", active ? "bg-gray-900 text-white" : "text-gray-300 hover:bg-gray-700 hover:text-white" ] %>
        <% end %>
      </div>
    </div>
    <div class="hidden items-center gap-3 text-sm text-gray-300 xl:flex">
      <span class="whitespace-nowrap"><%= Current.user.display_name %> · <%= Current.user.role.humanize %></span>
      <%= button_to "Sign out", session_path, method: :delete, class: "whitespace-nowrap rounded-md px-3 py-1.5 hover:bg-gray-700 hover:text-white" %>
    </div>

    <details class="relative xl:hidden" id="nav_menu">
      <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-md text-gray-200 hover:bg-gray-700 [&::-webkit-details-marker]:hidden" aria-label="Menu">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
      </summary>
      <div class="absolute right-0 z-40 mt-1 w-64 max-w-[calc(100vw-2rem)] rounded-lg bg-gray-800 p-2 shadow-xl ring-1 ring-black/20">
        <% links.each do |label, path, active| %>
          <%= link_to label, path, class: [ "block rounded-md px-3 py-3 text-base font-medium", active ? "bg-gray-900 text-white" : "text-gray-200 hover:bg-gray-700" ] %>
        <% end %>
        <div class="mt-2 border-t border-gray-700 pt-2">
          <p class="break-words px-3 py-1 text-sm text-gray-400"><%= Current.user.display_name %> · <%= Current.user.role.humanize %></p>
          <%= button_to "Sign out", session_path, method: :delete, class: "block w-full cursor-pointer rounded-md px-3 py-3 text-left text-base font-medium text-gray-200 hover:bg-gray-700" %>
        </div>
      </div>
    </details>
  </div>
</nav>
