<%# Centered card for signed-out pages (sign in, forgot password, set password).
    Usage: render layout: "sessions/card", locals: { heading: "Sign in", subheading: "..." } do ... end
    The flash renders inside the card, so the layout skips its own copy. %>
<% content_for :inline_flash, "1" %>
<div class="flex min-h-[75vh] items-center justify-center">
  <div class="w-full max-w-sm">
    <div class="mb-6 text-center">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900">CertTrack</h1>
      <h2 class="mt-3 text-base font-semibold text-gray-700"><%= heading %></h2>
      <% if local_assigns[:subheading].present? %>
        <p class="mt-1 text-sm text-gray-500"><%= subheading %></p>
      <% end %>
    </div>

    <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
      <%= render "layouts/flash" %>
      <%= yield %>
    </div>

    <p class="mt-6 text-center text-xs text-gray-400">Accounts are invite-only. Ask an admin for access.</p>
  </div>
</div>
