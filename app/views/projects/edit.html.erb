<%# name_was: a failed save leaves the typed (possibly blank) name on @project. %>
<% content_for :title, "Edit #{@project.name_was}" %>

<div class="max-w-3xl">
  <%= link_to "← #{@project.name_was}", project_path(@project), class: "text-sm text-blue-700 hover:underline" %>
  <h1 class="mt-2 text-2xl font-semibold">Edit project</h1>

  <div class="mt-6 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <%= render "form", project: @project %>
  </div>
</div>
