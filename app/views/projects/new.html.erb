<% content_for :title, "New project" %>

<div class="max-w-3xl">
  <%= link_to "← Projects", projects_path, class: "text-sm text-blue-700 hover:underline" %>
  <h1 class="mt-2 text-2xl font-semibold">New project</h1>
  <p class="mt-1 text-sm text-gray-500">After saving, choose the project's required certificates and assign its crew.</p>

  <div class="mt-6 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <%= render "form", project: @project %>
  </div>
</div>
