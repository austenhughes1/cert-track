<% content_for :title, "Packet · #{@project.display_name}" %>
<% building = @state == "building" %>
<% packet = @project.packet %>
<% expired = @project.packet_expired? %>
<% kept_for = Project::PACKET_KEPT_FOR.inspect %>
<% page_state = building ? "building" : (packet.attached? ? "ready" : (expired ? "expired" : "none")) %>
<% primary_button = "cursor-pointer rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>
<% secondary_button = "cursor-pointer rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" %>

<%= link_to "← Compliance matrix", project_compliance_path(@project), class: "text-sm text-blue-700 hover:underline" %>

<div class="mt-2 mb-6">
  <h1 class="text-2xl font-semibold">Compliance packet</h1>
  <p class="mt-1 text-sm text-gray-500">
    <%= @project.display_name %>. A zip of every file on each current certificate this project requires of its active crew,
    named <span class="font-mono text-xs">Last_First - CODE - exp YYYY-MM-DD</span>, plus an <span class="font-mono text-xs">index.pdf</span>
    listing each certificate and every missing or expired one. Certificates confirmed fake (a person checked them with the
    issuer) are left out of the zip and listed in the index; ones only flagged for review go in like any other.
  </p>
</div>

<%# While the job runs, auto-refresh reloads the page every 3 s; leaving the page stops it. %>
<section class="max-w-3xl rounded-lg border border-gray-200 bg-white p-5 shadow-sm" id="packet_status" data-state="<%= page_state %>"
  <%= tag.attributes(data: { controller: "auto-refresh", auto_refresh_interval_value: 3000 }) if building %>>
  <% if building %>
    <div class="flex items-center gap-3">
      <span class="inline-block size-4 animate-spin rounded-full border-2 border-blue-600 border-t-transparent" aria-hidden="true"></span>
      <div>
        <p class="font-medium text-gray-900">Building the packet…</p>
        <p class="text-sm text-gray-500">This page refreshes every few seconds until it is ready. <%= link_to "Refresh now", project_packet_path(@project), class: "text-blue-700 hover:underline" %></p>
      </div>
    </div>
  <% elsif packet.attached? %>
    <p class="flex items-center gap-2 font-medium text-gray-900">
      <span class="inline-flex rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-800">Ready</span>
      <%= packet.filename %>
    </p>
  <% elsif expired %>
    <p class="font-medium text-gray-900">The last zip has expired</p>
    <p class="mt-1 text-sm text-gray-500">
      The zip built <%= format_date(@project.packet_built_at) %> was deleted after <%= kept_for %> to save storage.
      Rebuild to get a new one with today's certificates. Its index PDF is still listed under Past builds.
    </p>
  <% else %>
    <p class="font-medium text-gray-900">No packet built yet</p>
    <p class="mt-1 text-sm text-gray-500">Build one to download it. It takes a few seconds to a minute, depending on the number of files.</p>
  <% end %>

  <% if @state == "failed" %>
    <div class="mt-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800" role="alert">
      The last build failed. Try again<%= can?(:admin) ? "; the error is in Jobs" : ", and tell an admin if it keeps failing" %>.
    </div>
  <% end %>

  <% if packet.attached? %>
    <dl class="mt-4 grid grid-cols-[6rem_1fr] gap-x-3 gap-y-1 text-sm">
      <dt class="text-gray-500">Built</dt>
      <dd>
        <% if (built_at = @project.packet_built_at) %>
          <time datetime="<%= built_at.iso8601 %>"><%= built_at.strftime("%b %-d, %Y %-l:%M %p") %></time>
          <span class="text-gray-500">(<%= time_ago_in_words(built_at) %> ago)</span>
        <% else %>
          —
        <% end %>
      </dd>
      <dt class="text-gray-500">Size</dt>
      <dd><%= number_to_human_size(packet.byte_size) %></dd>
      <% if (kept_until = @project.packet_kept_until) %>
        <dt class="text-gray-500">Kept until</dt>
        <dd id="packet_kept_until"><%= format_date(kept_until) %>, then deleted. Rebuild any time for a new one.</dd>
      <% end %>
    </dl>
    <% if building %>
      <p class="mt-3 text-sm text-gray-500">The previous packet can still be downloaded while the new one builds.</p>
    <% elsif @project.packet_built_at && @project.packet_built_at.to_date < Date.current %>
      <p class="mt-3 text-sm text-amber-800">Built before today. Rebuild it to pick up certificates added or changed since.</p>
    <% end %>
  <% end %>

  <div class="mt-5 flex flex-wrap items-center gap-2">
    <% if packet.attached? %>
      <%= link_to "Download zip", rails_blob_path(packet, disposition: "attachment"), class: primary_button, data: { turbo: false } %>
    <% end %>
    <% unless building %>
      <%= button_to packet.attached? || expired ? "Rebuild packet" : "Build packet", project_packet_path(@project),
            class: packet.attached? ? secondary_button : primary_button %>
    <% end %>
  </div>
</section>

<section class="mt-6 max-w-3xl" aria-labelledby="contents_heading">
  <h2 id="contents_heading" class="text-sm font-semibold text-gray-900">What a build will include today</h2>
  <dl class="mt-2 grid grid-cols-3 gap-3 text-sm">
    <div class="rounded-lg border border-gray-200 bg-white px-4 py-3">
      <dt class="text-gray-500">Certificates</dt>
      <dd class="text-xl font-semibold tabular-nums" id="packet_certificate_count"><%= @builder.certificate_cells.size %></dd>
    </div>
    <div class="rounded-lg border border-gray-200 bg-white px-4 py-3">
      <dt class="text-gray-500">Files attached</dt>
      <dd class="text-xl font-semibold tabular-nums" id="packet_file_count"><%= @builder.entries.size %></dd>
    </div>
    <div class="rounded-lg border border-gray-200 bg-white px-4 py-3">
      <dt class="text-gray-500">Gaps listed</dt>
      <dd class="text-xl font-semibold tabular-nums <%= "text-red-700" if @builder.report.gaps.any? %>" id="packet_gap_count"><%= @builder.report.gaps.size %></dd>
    </div>
  </dl>
  <% if (excluded = @builder.excluded_cells).any? %>
    <p class="mt-2 text-sm text-red-700" id="packet_excluded">
      <%= pluralize(excluded.size, "certificate") %> confirmed fake will be left out and listed in index.pdf:
      <%= excluded.map { |row, cell| "#{row.crew_member.display_name} (#{cell.certificate_type.code})" }.to_sentence %>.
    </p>
  <% end %>
  <% if @builder.certificate_cells.empty? %>
    <p class="mt-2 text-sm text-gray-500" id="packet_empty">
      <% if excluded.any? %>
        Nothing to package: every current certificate is confirmed fake and left out; index.pdf lists them.
      <% else %>
        Nothing to package yet: no one on this project holds a current certificate for a required type.
      <% end %>
      The packet will still contain index.pdf with the gaps.
    </p>
  <% end %>
</section>

<section class="mt-6 max-w-3xl" aria-labelledby="builds_heading" id="packet_builds">
  <h2 id="builds_heading" class="text-sm font-semibold text-gray-900">Past builds</h2>
  <p class="mt-1 text-sm text-gray-500">
    Each build's index PDF is kept as the record of what that packet held. Only the latest zip can be downloaded,
    for <%= kept_for %> after it is built.
  </p>
  <% if @builds.empty? %>
    <p class="mt-2 text-sm text-gray-500">No builds yet.</p>
  <% else %>
    <div class="mt-2 overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
          <tr>
            <th scope="col" class="px-4 py-2">Built</th>
            <th scope="col" class="px-4 py-2">By</th>
            <th scope="col" class="px-4 py-2 text-right">Certificates</th>
            <th scope="col" class="px-4 py-2 text-right">Files</th>
            <th scope="col" class="px-4 py-2 text-right">Gaps</th>
            <th scope="col" class="px-4 py-2"><span class="sr-only">Index PDF</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @builds.each do |build| %>
            <% built_at_label = build.built_at.strftime("%b %-d, %Y %-l:%M %p") %>
            <tr id="<%= dom_id(build) %>">
              <td class="whitespace-nowrap px-4 py-2 text-gray-900"><time datetime="<%= build.built_at.iso8601 %>"><%= built_at_label %></time></td>
              <td class="whitespace-nowrap px-4 py-2 text-gray-700"><%= build.built_by&.display_name || "—" %></td>
              <td class="whitespace-nowrap px-4 py-2 text-right tabular-nums"><%= build.certificate_count %></td>
              <td class="whitespace-nowrap px-4 py-2 text-right tabular-nums"><%= build.file_count %></td>
              <td class="whitespace-nowrap px-4 py-2 text-right tabular-nums <%= "text-red-700" if build.gap_count.positive? %>"><%= build.gap_count %></td>
              <td class="whitespace-nowrap px-4 py-2 text-right">
                <% if build.index_pdf.attached? %>
                  <%= link_to "Index PDF", rails_blob_path(build.index_pdf, disposition: "attachment"), class: "text-blue-700 hover:underline",
                        data: { turbo: false }, aria: { label: "Download the index PDF built #{built_at_label}" } %>
                <% else %>
                  <span class="text-gray-400">—</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
