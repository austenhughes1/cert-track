<%# Stat tiles. Locals: overview (Compliance::Overview), review_count (Integer).
    Counts are required certificate slots (person x type) on active projects; colours
    follow ComplianceHelper::BADGE_CLASSES. %>
<% totals = overview.totals %>
<% tiles = [
  [ "expired", "Expired", "past their expiry date", "border-red-300 bg-red-50 text-red-800" ],
  [ "missing", "Missing", "required, no current certificate", "border-red-300 bg-white text-red-700" ],
  [ "expiring", "Expiring", "within #{Compliance::EXPIRING_WINDOW} days", "border-amber-300 bg-amber-50 text-amber-800" ],
  [ "lapses_on_project", "Lapses on project", "valid now, expire before the project ends", "border-orange-300 bg-orange-50 text-orange-800" ]
] %>

<div class="grid grid-cols-2 gap-3 lg:grid-cols-5">
  <% tiles.each do |status, label, hint, colors| %>
    <% count = totals.fetch(status, 0) %>
    <% people = overview.crew_member_ids_with(status).size %>
    <%= link_to crew_members_path(status: status), id: "tile_#{status}",
          class: class_names("block rounded-lg border p-4 shadow-sm hover:ring-2 hover:ring-blue-300",
            colors => count.positive?, "border-gray-200 bg-white text-gray-500" => count.zero?) do %>
      <p class="text-xs font-semibold uppercase tracking-wide"><%= label %></p>
      <p class="mt-1 text-3xl font-semibold tabular-nums" data-count><%= count %></p>
      <p class="mt-1 text-xs opacity-80">
        <%= hint %><% if count.positive? %> · <%= pluralize(people, "person", plural: "people") %><% end %>
      </p>
    <% end %>
  <% end %>

  <%# Editors open the import review queue from here; viewers can't use it, so they get no link. %>
  <%= content_tag(can?(:editor) ? :a : :div, id: "tile_review_queue", href: (import_reviews_path if can?(:editor)),
        class: class_names("block rounded-lg border border-gray-200 bg-white p-4 text-gray-700 shadow-sm",
          "hover:ring-2 hover:ring-blue-300" => can?(:editor))) do %>
    <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Review queue</p>
    <p class="mt-1 text-3xl font-semibold tabular-nums" data-count><%= review_count %></p>
    <p class="mt-1 text-xs text-gray-500">
      <%= review_count.zero? ? "no imports waiting" : "#{"import".pluralize(review_count)} waiting for review" %>
    </p>
  <% end %>
</div>
