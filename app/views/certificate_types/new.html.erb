<% content_for :title, "New certificate type" %>

<div class="max-w-3xl">
  <%= link_to "← Master list", certificate_types_path, class: "text-sm text-blue-700 hover:underline" %>
  <h1 class="mt-2 text-2xl font-semibold">New certificate type</h1>
  <p class="mt-1 text-sm text-gray-500">Once it's on the master list, projects can require it and crew certificates can be recorded against it.</p>

  <div class="mt-6 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <%= render "form", certificate_type: @certificate_type %>
  </div>
</div>
