<% name = @certificate_type.name_was %>
<% content_for :title, "Edit #{name}" %>

<div class="max-w-3xl">
  <%= link_to "← Master list", certificate_types_path(status: ("all" unless @certificate_type.active_was)), class: "text-sm text-blue-700 hover:underline" %>
  <h1 class="mt-2 text-2xl font-semibold">Edit <%= name %></h1>
  <p class="mt-1 text-sm text-gray-500">
    <% if @usage.in_use? %>
      Used by <%= @usage.to_sentence %>.
    <% else %>
      Not used by any certificate, project or import yet.
    <% end %>
  </p>

  <div class="mt-6 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <%= render "form", certificate_type: @certificate_type, usage: @usage %>
  </div>

  <%# destroy deletes an unused type and deactivates one in use. %>
  <% deactivates = @usage.in_use? && @certificate_type.active_was %>
  <div class="mt-6 rounded-lg border border-red-200 bg-white p-6 shadow-sm" id="danger_zone">
    <h2 class="text-sm font-semibold text-gray-900"><%= deactivates ? "Deactivate this type" : "Delete this type" %></h2>
    <p class="mt-1 text-sm text-gray-600">
      <% if !@usage.in_use? %>
        Nothing uses it yet, so it can be removed from the master list for good.
      <% elsif deactivates %>
        It's used by <%= @usage.to_sentence %>, so it can't be deleted.
        Deactivating hides it from the default list and keeps its history.
      <% else %>
        It's used by <%= @usage.to_sentence %>, so it can't be deleted. It's already inactive.
      <% end %>
    </p>
    <% if !@usage.in_use? || deactivates %>
      <%= button_to deactivates ? "Deactivate" : "Delete", certificate_type_path(@certificate_type), method: :delete,
            class: "mt-3 cursor-pointer rounded-md border border-red-300 bg-white px-3 py-2 text-sm font-semibold text-red-700 shadow-sm hover:bg-red-50",
            form: { data: { turbo_confirm: deactivates ? "Deactivate #{name}?" : "Delete #{name}? This can't be undone." } } %>
    <% end %>
  </div>
</div>
