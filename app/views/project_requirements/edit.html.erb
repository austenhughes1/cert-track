<% content_for :title, "Requirements · #{@project.display_name}" %>
<% input_class = "block rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-blue-600 focus:outline-none focus:ring-1 focus:ring-blue-600" %>

<%= link_to "← #{@project.display_name}", project_path(@project), class: "text-sm text-blue-700 hover:underline" %>
<h1 class="mt-2 text-2xl font-semibold">Required certificates</h1>
<p class="mt-1 max-w-3xl text-sm text-gray-500">
  Tick <strong class="font-medium text-gray-700">Everyone</strong> to require a certificate of the whole crew, or tick roles to
  require it only of people holding that role on this project (their project role, else their own role).
</p>

<div class="mt-6 grid gap-6 xl:grid-cols-4">
  <div class="xl:col-span-3">
    <% if @certificate_types.empty? %>
      <div class="rounded-lg border border-dashed border-gray-300 bg-white px-6 py-12 text-center">
        <p class="text-sm font-medium text-gray-900">There are no active certificate types</p>
        <p class="mt-1 text-sm text-gray-500">
          <% if can?(:admin) %>
            <%= link_to "Add certificate types", certificate_types_path, class: "text-blue-700 hover:underline" %> first.
          <% else %>
            Ask an admin to add certificate types.
          <% end %>
        </p>
      </div>
    <% else %>
      <%= form_with url: project_requirements_path(@project), method: :patch, id: "requirements_form",
            data: { controller: "requirements-grid", action: "change->requirements-grid#refresh" } do |form| %>
        <%# Always sent, so unticking every box still submits (and clears the requirements). %>
        <%= hidden_field_tag "requirement_keys[]", "", id: nil %>

        <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
          <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-50 text-xs font-semibold uppercase tracking-wide text-gray-500">
              <tr>
                <th scope="col" class="px-4 py-2 text-left">Certificate type</th>
                <th scope="col" class="px-3 py-2 text-center">Everyone</th>
                <% @crew_roles.each do |role| %>
                  <th scope="col" class="px-3 py-2 text-center font-medium normal-case text-gray-600"><%= role.name %> only</th>
                <% end %>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @certificate_types.each do |type| %>
                <tr id="<%= dom_id(type, :requirements) %>" class="hover:bg-gray-50" data-requirements-grid-target="row">
                  <th scope="row" class="px-4 py-2 text-left font-normal">
                    <span class="font-medium text-gray-900"><%= type.name %></span>
                    <span class="ml-1 font-mono text-xs text-gray-500"><%= type.code %></span>
                    <% unless type.active? %><span class="ml-1 rounded bg-gray-100 px-1.5 text-xs text-gray-500">Retired</span><% end %>
                    <span class="block text-xs text-gray-400">
                      <%= type.never_expires? ? "Never expires" : "Valid #{pluralize(type.validity_months, 'month')}" %>
                    </span>
                  </th>
                  <% [ nil, *@crew_roles ].each do |role| %>
                    <% key = Projects::UpdateRequirements.key(type.id, role&.id) %>
                    <% requirement = @requirements_by_key[key] %>
                    <% label = "#{type.name}: #{role ? "#{role.name} only" : "everyone"}" %>
                    <td class="<%= class_names("px-3 py-2 text-center", "bg-blue-50/40": role.nil?) %>"
                        title="<%= requirement&.notes %>" data-requirements-grid-target="<%= role ? "roleCell" : "everyoneCell" %>">
                      <%= check_box_tag "requirement_keys[]", key, requirement.present?,
                            id: "requirement_#{type.id}_#{role&.id || "everyone"}",
                            class: "h-4 w-4 cursor-pointer rounded border-gray-300 text-blue-600",
                            aria: { label: label } %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="mt-4 flex items-center gap-3">
          <%= form.submit "Save requirements",
                class: "cursor-pointer rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>
          <%= link_to "Cancel", project_path(@project), class: "text-sm text-gray-600 hover:underline" %>
          <span class="hidden text-sm text-amber-700" data-requirements-grid-target="status">Unsaved changes</span>
        </div>
        <p class="mt-2 text-xs text-gray-500">Role boxes on a row already required of everyone are dimmed: they add nothing while Everyone is ticked.</p>
      <% end %>
    <% end %>
  </div>

  <aside class="space-y-4">
    <section class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm" aria-labelledby="copy_heading">
      <h2 id="copy_heading" class="text-sm font-semibold text-gray-900">Copy from another project</h2>
      <p class="mt-1 text-xs text-gray-500">
        Adds that project's requirements (with role limits and notes) to this one. Ones already here and retired types are
        skipped; nothing is removed. Save any changes above first.
      </p>
      <% if @copy_sources.empty? %>
        <p class="mt-3 text-sm text-gray-500">No other project has requirements yet.</p>
      <% else %>
        <%= form_with url: copy_project_requirements_path(@project), method: :post, class: "mt-3 space-y-3" do |form| %>
          <%= label_tag :source_project_id, "Project", class: "sr-only" %>
          <%= select_tag :source_project_id,
                options_for_select(@copy_sources.map { |source|
                  [ "#{source.display_name} (#{pluralize(@requirement_counts.fetch(source.id), 'requirement')})", source.id ]
                }),
                prompt: "Choose a project…", required: true, class: "#{input_class} w-full" %>
          <%= form.submit "Copy requirements",
                class: "cursor-pointer rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" %>
        <% end %>
      <% end %>
    </section>
  </aside>
</div>
