<% content_for :title, "Crew roles" %>

<%= link_to "← Crew", crew_members_path, class: "text-sm text-blue-700 hover:underline" %>

<div class="mt-2 mb-4 flex items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold">Crew roles</h1>
    <p class="mt-1 text-sm text-gray-500">Roles decide which role-specific project requirements apply to a person. A role in use can't be deleted.</p>
  </div>
  <% if can?(:editor) %>
    <%= link_to "Add role", new_crew_role_path, class: "rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>
  <% end %>
</div>

<% if @crew_roles.empty? %>
  <div class="rounded-lg border border-dashed border-gray-300 bg-white px-6 py-12 text-center">
    <p class="text-sm font-medium text-gray-900">No roles yet</p>
    <p class="mt-1 text-sm text-gray-500">Add roles such as Foreman, Operator or Climber to set role-specific requirements.</p>
  </div>
<% else %>
  <div class="max-w-3xl overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
        <tr>
          <th scope="col" class="px-4 py-2">Name</th>
          <th scope="col" class="px-4 py-2 text-right">Crew members</th>
          <th scope="col" class="px-4 py-2 text-right">Requirements</th>
          <th scope="col" class="px-4 py-2 text-right" title="Assignments that set this role on a project">Project overrides</th>
          <% if can?(:editor) %>
            <th scope="col" class="px-4 py-2"><span class="sr-only">Actions</span></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @crew_roles.each do |crew_role| %>
          <% members = @member_counts.fetch(crew_role.id, 0) %>
          <% requirements = @requirement_counts.fetch(crew_role.id, 0) %>
          <% assignments = @assignment_counts.fetch(crew_role.id, 0) %>
          <tr id="<%= dom_id(crew_role) %>" class="hover:bg-gray-50">
            <td class="whitespace-nowrap px-4 py-2 font-medium text-gray-900">
              <% if members.positive? %>
                <%= link_to crew_role.name, crew_members_path(crew_role_id: crew_role.id), class: "text-blue-700 hover:underline" %>
              <% else %>
                <%= crew_role.name %>
              <% end %>
            </td>
            <td class="whitespace-nowrap px-4 py-2 text-right tabular-nums"><%= members %></td>
            <td class="whitespace-nowrap px-4 py-2 text-right tabular-nums"><%= requirements %></td>
            <td class="whitespace-nowrap px-4 py-2 text-right tabular-nums"><%= assignments %></td>
            <% if can?(:editor) %>
              <td class="whitespace-nowrap px-4 py-2">
                <div class="flex items-center justify-end gap-3">
                  <%= link_to "Edit", edit_crew_role_path(crew_role), class: "text-blue-700 hover:underline" %>
                  <% if (members + requirements + assignments).zero? %>
                    <%= button_to "Delete", crew_role_path(crew_role), method: :delete, class: "cursor-pointer text-red-700 hover:underline",
                          form: { data: { turbo_confirm: "Delete the #{crew_role.name} role?" } } %>
                  <% else %>
                    <span class="text-xs text-gray-400" title="Reassign its members, requirements and project overrides first">In use</span>
                  <% end %>
                </div>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
