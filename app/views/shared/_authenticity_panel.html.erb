<%# locals: (record:, review_form: nil) %>
<%# Authenticity of a Certificate or an ImportItem (docs/PLAN.md, Phase 3b): the status, what was
    found, who checked and when, and the links a person opens to check it. Admins and managers
    record a result (the four buttons, with an optional note) or run "Check again"; viewers see
    it read-only. It holds forms, so don't render it inside another form. Only https:// links
    are rendered, always in a new tab without a referrer; issuer text is escaped like any other.
    A link that imitates an issuer's site, or is disguised, is never linked. When the link isn't on
    the issuer's own website, the issuer's own page comes first.
    Any flagged result gets the red border. Only a person's Not found or Doesn't match makes it
    confirmed fake (counted as not valid, left out of packets), so those two buttons ask first; a
    flag from an automatic check, a QR code or a lookalike link is only flagged for review and still
    counts by its dates (Authenticity).
    review_form: the id of the review screen's form. The note and buttons then belong to that form
    and post to ImportReviewsController#check, which saves the edits typed there first, so what is
    checked or recorded is what the reviewer sees.
    Check again posts authenticity[shown_at], when this page was shown: it replaces a person's
    result only if this page showed it (AuthenticityChecksController.recheck_requested_at). %>
<% subject = authenticity_subject(record) %>
<% issuer = subject.issuer %>
<% link_url = authenticity_safe_url(subject.url) %>
<% link_suspicion = authenticity_link_suspicion(link_url) unless record.authenticity_suspicious? %>
<% direct_url = link_url unless record.authenticity_suspicious? || link_suspicion %>
<% lookup_url = authenticity_safe_url(issuer&.lookup_url) %>
<% issuer_url = authenticity_safe_url(issuer&.link_for(subject.code)) %>
<% off_site = direct_url && issuer && issuer.domains.any? && !issuer.owns_url?(direct_url) %>
<% own_first = issuer_url || lookup_url if off_site || direct_url.nil? %>
<% unconfirmed = authenticity_issuer_unconfirmed?(record) %>
<% label_class = "text-xs font-medium uppercase tracking-wide text-gray-500" %>
<% link_class = "inline-flex items-center gap-1 rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-blue-700 shadow-sm hover:bg-gray-50" %>
<% button_class = "cursor-pointer rounded-md border bg-white px-3 py-1.5 text-sm font-medium shadow-sm" %>
<% recheck_class = "cursor-pointer rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" %>
<% note_class = "block w-full rounded-md border border-gray-300 px-3 py-1.5 text-sm shadow-sm focus:border-blue-600 focus:outline-none focus:ring-1 focus:ring-blue-600" %>
<% recheck_confirm = if record.authenticity_confirmed_fake?
     "Check again? The automatic result replaces the one a person recorded, so it is no longer confirmed fake."
   elsif record.authenticity_set_by_person?
     "Check again? The automatic result replaces the one a person recorded."
   end %>
<% fake_buttons_hint = "Not found and Doesn't match mark it as fake. Use them only after checking with the issuer." %>
<% shown_at = Time.current.iso8601(6) %>

<section id="authenticity" class="<%= class_names("rounded-lg border bg-white p-4 shadow-sm",
           record.authenticity_flagged? ? "border-red-300" : "border-gray-200") %>" aria-labelledby="authenticity_heading">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 id="authenticity_heading" class="text-sm font-semibold text-gray-900">Authenticity</h2>
    <div class="flex items-center gap-2">
      <% if record.authenticity_confirmed_fake? %>
        <span class="text-xs text-gray-600" id="authenticity_fake_reason"><%= record.authenticity_label %></span>
      <% end %>
      <span id="authenticity_status"><%= authenticity_badge(record) %></span>
    </div>
  </div>

  <% if record.authenticity_note.present? %>
    <p class="mt-2 whitespace-pre-line text-sm text-gray-800" id="authenticity_note"><%= record.authenticity_note %></p>
  <% end %>
  <% if record.authenticity_confirmed_fake? %>
    <p class="mt-2 text-sm font-medium text-red-900" id="authenticity_fake_hint"><%= authenticity_fake_sentence(record) %></p>
  <% elsif record.authenticity_flagged? %>
    <p class="mt-2 text-sm text-red-800" id="authenticity_flagged_hint"><%= authenticity_flagged_sentence(record) %></p>
  <% end %>
  <p class="mt-1 text-xs text-gray-500" id="authenticity_checked"><%= authenticity_checked_sentence(record) %></p>

  <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
    <div>
      <dt class="<%= label_class %>">Issuer</dt>
      <dd class="mt-0.5 text-gray-900" id="authenticity_issuer"><%= issuer&.name || tag.span("Not known", class: "text-gray-400") %></dd>
      <% if unconfirmed %>
        <dd class="mt-0.5 text-xs text-amber-800" id="authenticity_issuer_unconfirmed">
          Suggested, not confirmed.
          <% if issuer.automatic_check? %>Save it with the form above and CertTrack checks it with the issuer automatically.<% end %>
        </dd>
      <% end %>
    </div>
    <div>
      <dt class="<%= label_class %>">Verification code</dt>
      <dd class="mt-0.5 break-all font-mono text-xs text-gray-900" id="authenticity_code"><%= subject.code || tag.span("None", class: "font-sans text-sm text-gray-400") %></dd>
    </div>
  </dl>

  <div class="mt-3 space-y-2 text-sm" id="authenticity_links">
    <% if record.authenticity_suspicious? %>
      <p class="text-red-800" id="authenticity_suspicious_hint">
        Don't open this certificate's verification link or QR code: it points to a website that looks like an issuer's but isn't.
        <% if own_first %>Use the issuer's own page instead.<% end %>
      </p>
    <% elsif link_suspicion %>
      <p class="text-red-800" id="authenticity_link_warning"><%= authenticity_suspicion_sentence(link_suspicion) %></p>
    <% end %>

    <% if own_first == issuer_url && issuer_url %>
      <%= link_to issuer_url, target: "_blank", rel: "noopener noreferrer", id: "authenticity_issuer_link", class: link_class do %>
        Open <%= issuer.name %>'s verification page <span class="font-normal text-gray-500">(<%= authenticity_link_host(issuer_url) %>)</span>
      <% end %>
    <% elsif own_first %>
      <%= link_to lookup_url, target: "_blank", rel: "noopener noreferrer", id: "authenticity_lookup", class: link_class do %>
        Open <%= issuer.name %>'s lookup page <span class="font-normal text-gray-500">(<%= authenticity_link_host(lookup_url) %>)</span>
      <% end %>
      <% if subject.code %>
        <p class="text-xs text-gray-500">Type the verification code there.</p>
      <% end %>
    <% end %>

    <% if direct_url %>
      <%= link_to direct_url, target: "_blank", rel: "noopener noreferrer", id: "authenticity_open", class: link_class do %>
        Open verification page <span class="font-normal text-gray-500">(<%= authenticity_link_host(direct_url) %>)</span>
      <% end %>
      <% if off_site %>
        <p class="text-xs text-amber-800" id="authenticity_off_site">This link isn't on <%= issuer.name %>'s own website. Check where it goes before trusting it.</p>
      <% end %>
    <% end %>

    <% if direct_url.nil? && issuer&.verification_notes.present? %>
      <div id="authenticity_notes">
        <p class="<%= label_class %>">How to verify</p>
        <p class="mt-0.5 whitespace-pre-line text-gray-700"><%= issuer.verification_notes %></p>
      </div>
    <% elsif direct_url.nil? && own_first.nil? %>
      <p class="text-gray-500" id="authenticity_nothing">
        <% if issuer %>
          There is no lookup page on file for <%= issuer.name %>.
        <% else %>
          The issuer isn't known, so there is no lookup page to open.
        <% end %>
      </p>
    <% end %>
  </div>

  <% if can?(:editor) && review_form %>
    <%# Part of the review form (the form= attribute): ImportReviewsController#check saves its edits first. %>
    <div id="authenticity_form" class="mt-4 space-y-2 border-t border-gray-100 pt-3">
      <%= label_tag "authenticity_result_note", "Record what you found (note optional)", class: "block text-xs font-medium text-gray-600" %>
      <%= text_area_tag "authenticity[note]", nil, id: "authenticity_result_note", form: review_form, rows: 2,
            maxlength: AuthenticityChecksController::NOTE_LIMIT, placeholder: "e.g. Issuer's page shows the same name and dates", class: note_class %>
      <div class="flex flex-wrap gap-2">
        <% AuthenticityHelper::RESULT_BUTTONS.each do |status, (label, colors)| %>
          <%= button_tag label, type: "submit", form: review_form, formaction: check_import_review_path(record), formmethod: "post",
                formnovalidate: true, name: "authenticity[status]", value: status,
                data: { result: status, turbo_confirm: authenticity_result_confirm(record, status) }, class: "#{button_class} #{colors}" %>
        <% end %>
      </div>
      <p class="text-xs text-gray-500" id="authenticity_fake_buttons_hint"><%= fake_buttons_hint %></p>
    </div>
    <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
      <p class="text-xs text-gray-500" id="authenticity_recheck_hint">
        <% if record.authenticity_set_by_person? %>
          Automatic checks leave a person's result alone. Check again to replace it.
        <% end %>
        These buttons save your edits above first, so the issuer, code and link you typed are what get checked.
      </p>
      <%= hidden_field_tag "authenticity[shown_at]", shown_at, form: review_form, id: "authenticity_shown_at" %>
      <%= button_tag "Check again", type: "submit", name: nil, id: "authenticity_recheck", form: review_form, formaction: check_import_review_path(record),
            formmethod: "post", formnovalidate: true, data: { turbo_confirm: recheck_confirm }, class: recheck_class %>
    </div>
  <% elsif can?(:editor) %>
    <%= form_with url: subject.update_path, method: :patch, scope: :authenticity, id: "authenticity_form",
          class: "mt-4 space-y-2 border-t border-gray-100 pt-3" do |form| %>
      <%= form.label :note, "Record what you found (note optional)", for: "authenticity_result_note", class: "block text-xs font-medium text-gray-600" %>
      <%= form.text_area :note, id: "authenticity_result_note", rows: 2, maxlength: AuthenticityChecksController::NOTE_LIMIT,
            placeholder: "e.g. Issuer's page shows the same name and dates", class: note_class %>
      <div class="flex flex-wrap gap-2">
        <% AuthenticityHelper::RESULT_BUTTONS.each do |status, (label, colors)| %>
          <%= form.button label, type: "submit", name: "authenticity[status]", value: status,
                data: { result: status, turbo_confirm: authenticity_result_confirm(record, status) }, class: "#{button_class} #{colors}" %>
        <% end %>
      </div>
      <p class="text-xs text-gray-500" id="authenticity_fake_buttons_hint"><%= fake_buttons_hint %></p>
    <% end %>
    <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
      <p class="text-xs text-gray-500" id="authenticity_recheck_hint">
        <% if record.authenticity_set_by_person? %>
          Automatic checks leave a person's result alone. Check again to replace it.
        <% else %>
          Runs the automatic checks again with the issuer, code and link above.
        <% end %>
      </p>
      <%= button_to "Check again", subject.recheck_path, params: { authenticity: { shown_at: shown_at } },
            form: { id: "authenticity_recheck", data: { turbo_confirm: recheck_confirm } }, class: recheck_class %>
    </div>
  <% end %>
</section>
