<% name = @certificate_issuer.name_was %>
<% content_for :title, "Edit #{name}" %>

<div class="max-w-3xl">
  <%= link_to "← Issuers", certificate_issuers_path(status: ("all" unless @certificate_issuer.active_was)), class: "text-sm text-blue-700 hover:underline" %>
  <h1 class="mt-2 text-2xl font-semibold">Edit <%= name %></h1>
  <p class="mt-1 text-sm text-gray-500">
    <% if @usage.in_use? %>
      Used by <%= @usage.to_sentence %>.
    <% else %>
      Not used by any certificate or import yet.
    <% end %>
  </p>
  <% if certificate_issuer_needs_details?(@certificate_issuer) %>
    <div class="mt-4 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900" id="needs_details_note">
      Added with <%= CertificateIssuersHelper::OTHER_LABEL %> in an issuer picker. Fill in how it verifies and its website domains
      so reviewers know how to check its certificates and imports can recognise its QR codes.
    </div>
  <% end %>

  <div class="mt-6 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <%= render "form", certificate_issuer: @certificate_issuer %>
  </div>

  <%# destroy deletes an unused issuer and deactivates one in use. %>
  <% deactivates = @usage.in_use? && @certificate_issuer.active_was %>
  <div class="mt-6 rounded-lg border border-red-200 bg-white p-6 shadow-sm" id="danger_zone">
    <h2 class="text-sm font-semibold text-gray-900"><%= deactivates ? "Deactivate this issuer" : "Delete this issuer" %></h2>
    <p class="mt-1 text-sm text-gray-600">
      <% if !@usage.in_use? %>
        Nothing uses it yet, so it can be removed for good.
      <% elsif deactivates %>
        It's used by <%= @usage.to_sentence %>, so it can't be deleted.
        Deactivating hides it from issuer pickers and keeps it on those certificates.
      <% else %>
        It's used by <%= @usage.to_sentence %>, so it can't be deleted. It's already inactive.
      <% end %>
    </p>
    <% if !@usage.in_use? || deactivates %>
      <%= button_to deactivates ? "Deactivate" : "Delete", certificate_issuer_path(@certificate_issuer), method: :delete,
            class: "mt-3 cursor-pointer rounded-md border border-red-300 bg-white px-3 py-2 text-sm font-semibold text-red-700 shadow-sm hover:bg-red-50",
            form: { data: { turbo_confirm: deactivates ? "Deactivate #{name}?" : "Delete #{name}? This can't be undone." } } %>
    <% end %>
  </div>
</div>
