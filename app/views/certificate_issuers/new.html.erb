<% content_for :title, "New issuer" %>

<div class="max-w-3xl">
  <%= link_to "← Issuers", certificate_issuers_path, class: "text-sm text-blue-700 hover:underline" %>
  <h1 class="mt-2 text-2xl font-semibold">New issuer</h1>
  <p class="mt-1 text-sm text-gray-500">Once it's on the list, certificates can name it and imports can recognise it.</p>

  <div class="mt-6 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <%= render "form", certificate_issuer: @certificate_issuer %>
  </div>
</div>
