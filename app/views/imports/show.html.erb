<% content_for :title, "Import batch ##{@batch.id}" %>

<%= link_to "← Imports", imports_path, class: "text-sm text-blue-700 hover:underline" %>

<div class="mt-2 mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold">Import batch #<%= @batch.id %></h1>
    <p class="mt-1 text-sm text-gray-500">
      Uploaded by <%= @batch.uploaded_by.display_name %> on <%= import_time(@batch.created_at) %>
      · <%= pluralize(@batch.uploads.count, "upload") %> dropped
    </p>
  </div>
  <%= link_to "Review queue", import_reviews_path,
        class: "rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" %>
</div>

<%= render "imports/progress", batch: @batch, progress: @progress, items: @items, items_total: @progress.fetch(:total) %>
