<%# locals: (batches:) %>
<%# Recent batches, with counts preloaded by ImportBatch.preload_progress. While any is still
    being read, frame-refresh reloads just this frame every 3 s, or every 60 s when all that is
    left is parked until the AI allocation resets at 00:05 UTC (the drop zone is left alone). %>
<% live_batches = batches.select { |batch| batch.receiving? || batch.processing? } %>
<% live = live_batches.any? %>
<% interval = import_refresh_interval(live_batches.map(&:progress)) if live %>
<% columns = [ [ "accepted", "Accepted" ], [ "needs_review", "Review" ], [ "duplicate", "Duplicates" ], [ "rejected", "Rejected" ], [ "failed", "Failed" ] ] %>

<section class="mt-8" aria-labelledby="recent_imports_heading">
  <h2 id="recent_imports_heading" class="mb-2 text-lg font-semibold">Recent batches</h2>

  <%= turbo_frame_tag "recent_imports", target: "_top" do %>
    <div <%= tag.attributes(data: { controller: "frame-refresh", frame_refresh_interval_value: interval }) if live %>>
      <% if batches.empty? %>
        <div class="rounded-lg border border-dashed border-gray-300 bg-white px-6 py-12 text-center">
          <p class="text-sm font-medium text-gray-900">No imports yet</p>
          <p class="mt-1 text-sm text-gray-500">Drop a few certificate files above to start the first batch.</p>
        </div>
      <% else %>
        <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
          <table class="min-w-full divide-y divide-gray-200 text-sm" id="import_batches">
            <thead class="bg-gray-50 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
              <tr>
                <th scope="col" class="px-4 py-2">Batch</th>
                <th scope="col" class="px-4 py-2">Uploaded by</th>
                <th scope="col" class="px-4 py-2">When</th>
                <th scope="col" class="px-4 py-2 text-right" title="Files seen, including those inside zips">Files</th>
                <th scope="col" class="px-4 py-2">Status</th>
                <th scope="col" class="px-4 py-2 text-right" title="Certificates found">Items</th>
                <% columns.each do |_status, label| %>
                  <th scope="col" class="px-4 py-2 text-right"><%= label %></th>
                <% end %>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% batches.each do |batch| %>
                <% counts = batch.status_counts %>
                <tr id="<%= dom_id(batch) %>" class="hover:bg-gray-50">
                  <td class="whitespace-nowrap px-4 py-2">
                    <%= link_to "##{batch.id}", import_path(batch), class: "font-medium text-blue-700 hover:underline",
                          aria: { label: "Batch #{batch.id}" } %>
                  </td>
                  <td class="whitespace-nowrap px-4 py-2 text-gray-700"><%= batch.uploaded_by.display_name %></td>
                  <td class="whitespace-nowrap px-4 py-2 text-gray-700"><%= import_time(batch.created_at) %></td>
                  <td class="whitespace-nowrap px-4 py-2 text-right tabular-nums"><%= batch.files_count %></td>
                  <td class="whitespace-nowrap px-4 py-2"><%= import_batch_status_badge(batch) %></td>
                  <td class="whitespace-nowrap px-4 py-2 text-right tabular-nums"><%= counts.values.sum %></td>
                  <% columns.each do |status, _label| %>
                    <td class="whitespace-nowrap px-4 py-2 text-right tabular-nums <%= "text-gray-400" if counts[status].zero? %>"
                        data-count="<%= status %>"><%= counts[status] %></td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
