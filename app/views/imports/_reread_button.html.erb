<%# locals: (item:, button_class: "cursor-pointer font-medium text-blue-700 hover:underline") %>
<%# "Read again" (ImportReviewsController#reread, Imports::Reread): the whole file goes back
    through the pipeline, which clears what was read and reviewed and uses part of today's free
    AI allocation, so the button asks first. Show it only when can?(:editor) and
    Imports::Reread.allowed?(item). %>
<% name = item.original_filename.presence || "item #{item.id}" %>
<%= button_to "Read again", reread_import_review_path(item), id: "reread_#{item.id}", class: button_class,
      aria: { label: "Read #{name} again" },
      form: { class: "inline", data: { turbo_confirm: "Read #{name} again? The AI reads the file from the start, which uses " \
                                                      "part of today's free AI allocation. What it read before, and any edits " \
                                                      "or rejection, are cleared." } } %>
