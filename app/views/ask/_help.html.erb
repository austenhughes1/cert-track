<%# locals: (examples:) %>
<%# Shown before the first question: what the box understands. %>
<section id="ask_help" class="mt-6 rounded-lg border border-dashed border-gray-300 bg-white px-6 py-6" aria-labelledby="ask_help_heading">
  <h2 id="ask_help_heading" class="text-sm font-medium text-gray-900">What you can ask</h2>
  <dl class="mt-3 grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
    <% [
      [ "Does someone hold a certificate?", examples[0] ],
      [ "Who holds a certificate?", examples[1] ],
      [ "What does one person have?", examples[2] ],
      [ "What expires soon? (default: 30 days)", examples[3] ],
      [ "What's missing on a project, or on every active one?", examples[4] ]
    ].each do |description, example| %>
      <div>
        <dt class="text-gray-600"><%= description %></dt>
        <dd class="mt-0.5"><%= link_to example, ask_path(q: example), class: "text-blue-700 hover:underline" %></dd>
      </div>
    <% end %>
  </dl>
  <p class="mt-4 text-xs text-gray-500">Typos, nicknames ("Bob" for Robert) and codes ("OSHA30") are fine. Every answer names its evidence and links to it.</p>
</section>
