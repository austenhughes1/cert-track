<% content_for :title, "Edit #{@saved_type_name} · #{@crew_member.display_name}" %>

<%= link_to "← #{@saved_type_name}", crew_member_certificate_path(@crew_member, @certificate),
      class: "text-sm text-blue-700 hover:underline" %>

<div class="mt-2 max-w-3xl">
  <h1 class="text-2xl font-semibold">Edit <%= @saved_type_name %></h1>
  <p class="mt-1 text-sm text-gray-500"><%= @crew_member.display_name %></p>

  <section class="mt-6 rounded-lg border border-gray-200 bg-white p-6 shadow-sm" aria-labelledby="attached_files_heading">
    <h2 id="attached_files_heading" class="mb-3 text-base font-semibold">Attached files</h2>
    <%= render "certificates/files", certificate: @certificate, compact: false, removable: true %>
  </section>

  <div class="mt-6 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <%= render "form", certificate: @certificate, crew_member: @crew_member,
          issuer_choice: @issuer_choice, other_issuer_name: @other_issuer_name %>
  </div>
</div>
