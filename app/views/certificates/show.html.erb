<% type = @certificate.certificate_type %>
<% content_for :title, "#{type.name} · #{@crew_member.display_name}" %>
<% current_replacement = @history.find(&:current?) if @certificate.superseded? %>
<% expiry_sources = {
     "printed" => "printed on the card",
     "computed" => "completed date plus #{type.validity_months ? pluralize(type.validity_months, "month") : "the type's validity"}",
     "manual" => "entered by hand",
     "none" => "this type never expires"
   } %>
<% label_class = "text-xs font-medium uppercase tracking-wide text-gray-500" %>
<% dash = tag.span("—", class: "text-gray-400") %>

<%= link_to "← #{@crew_member.display_name}", crew_member_path(@crew_member, anchor: "certificates"), class: "text-sm text-blue-700 hover:underline" %>

<div class="mt-2 mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold">
      <%= type.name %>
      <span class="ml-1 align-middle text-sm font-normal text-gray-500"><%= type.code %></span>
    </h1>
    <p class="mt-1 text-sm text-gray-500">
      <%= link_to @crew_member.display_name, crew_member_path(@crew_member), class: "text-blue-700 hover:underline" %>
      <%= " · #{@crew_member.crew_role.name}" if @crew_member.crew_role %>
    </p>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <% if can?(:editor) %>
      <%= link_to "Edit", edit_crew_member_certificate_path(@crew_member, @certificate),
            class: "rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" %>
    <% end %>
    <% if can?(:admin) %>
      <%= button_to "Delete", crew_member_certificate_path(@crew_member, @certificate), method: :delete,
            class: "cursor-pointer rounded-md px-3 py-2 text-sm font-medium text-red-700 hover:bg-red-50",
            form: { data: { turbo_confirm: "Delete this #{type.name} certificate and its files? #{@certificate.current? ? "The previous one, if any, becomes current again." : ""}".strip } } %>
    <% end %>
  </div>
</div>

<% if @certificate.superseded? %>
  <div class="mb-6 rounded-md border border-gray-200 bg-gray-100 px-4 py-3 text-sm text-gray-700" role="status" id="superseded_notice">
    Replaced on <%= format_date(@certificate.superseded_at) %> by a newer <%= type.name %> certificate.
    It is kept for the record and doesn't count toward compliance.
    <% if current_replacement %>
      <%= link_to "View the current one", crew_member_certificate_path(@crew_member, current_replacement), class: "text-blue-700 hover:underline" %>.
    <% end %>
  </div>
<% end %>

<section class="mb-8 rounded-lg border border-gray-200 bg-white p-4 shadow-sm" aria-labelledby="certificate_details_heading">
  <h2 id="certificate_details_heading" class="sr-only">Details</h2>
  <dl class="grid gap-x-6 gap-y-4 text-sm sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <dt class="<%= label_class %>">Status</dt>
      <dd class="mt-1" id="certificate_status">
        <% if @certificate.current? %>
          <%= compliance_badge(@certificate.compliance_status) %>
          <% if (days = @certificate.days_until_expiry) %>
            <span class="ml-1 text-xs text-gray-500"><%= days.negative? ? "#{pluralize(-days, "day")} ago" : "in #{pluralize(days, "day")}" %></span>
          <% end %>
        <% else %>
          <span class="inline-flex rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">Replaced</span>
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="<%= label_class %>">Completed</dt>
      <dd class="mt-0.5 text-gray-900"><%= format_date(@certificate.completed_on) %></dd>
    </div>
    <div>
      <dt class="<%= label_class %>">Expires</dt>
      <dd class="mt-0.5 text-gray-900" id="certificate_expires_on">
        <%= @certificate.never_expires? ? "Never" : format_date(@certificate.expires_on) %>
        <span class="block text-xs text-gray-500"><%= expiry_sources.fetch(@certificate.expires_on_source, @certificate.expires_on_source.to_s.humanize) %></span>
      </dd>
    </div>
    <div>
      <dt class="<%= label_class %>">Number</dt>
      <dd class="mt-0.5 font-mono text-xs text-gray-900"><%= @certificate.certificate_number || dash %></dd>
    </div>
    <div>
      <dt class="<%= label_class %>">Issued by</dt>
      <dd class="mt-0.5 text-gray-900"><%= @certificate.issued_by || dash %></dd>
    </div>
    <div>
      <dt class="<%= label_class %>">Issuing body</dt>
      <dd class="mt-0.5 text-gray-900"><%= type.issuing_body.presence || dash %></dd>
    </div>
    <div>
      <dt class="<%= label_class %>">Entered</dt>
      <dd class="mt-0.5 text-gray-900"><%= @certificate.source_import? ? "From a bulk import" : "By hand" %></dd>
    </div>
    <div>
      <dt class="<%= label_class %>">Verified</dt>
      <dd class="mt-0.5 text-gray-900" id="certificate_verified">
        <% if @certificate.verified_at %>
          <%= @certificate.verified_by&.display_name || "Unknown user" %>
          <span class="block text-xs text-gray-500"><%= format_date(@certificate.verified_at) %></span>
        <% else %>
          <span class="text-gray-400">Not verified</span>
        <% end %>
      </dd>
    </div>
    <% if @certificate.notes.present? %>
      <div class="sm:col-span-2 lg:col-span-4">
        <dt class="<%= label_class %>">Notes</dt>
        <dd class="mt-0.5 whitespace-pre-line text-gray-900"><%= @certificate.notes %></dd>
      </div>
    <% end %>
  </dl>
</section>

<section id="files" class="mb-8" aria-labelledby="files_heading">
  <div class="mb-2 flex items-end justify-between gap-4">
    <h2 id="files_heading" class="text-lg font-semibold">Files</h2>
    <% if can?(:editor) %>
      <%= link_to "Add files", edit_crew_member_certificate_path(@crew_member, @certificate), class: "text-sm text-blue-700 hover:underline" %>
    <% end %>
  </div>
  <% if @certificate.files.attached? %>
    <%= render "certificates/files", certificate: @certificate, compact: false, removable: true %>
  <% else %>
    <div class="rounded-lg border border-dashed border-gray-300 bg-white px-6 py-8 text-center">
      <p class="text-sm font-medium text-gray-900">No files attached</p>
      <p class="mt-1 text-sm text-gray-500">Scans or photos of the card make the record checkable and go into project packets.</p>
    </div>
  <% end %>
</section>

<section id="history" aria-labelledby="history_heading">
  <h2 id="history_heading" class="mb-2 text-lg font-semibold">Other <%= type.name %> certificates for <%= @crew_member.display_name %></h2>
  <% if @history.empty? %>
    <p class="text-sm text-gray-500">None. This is the only one on file.</p>
  <% else %>
    <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
          <tr>
            <th scope="col" class="px-4 py-2">Completed</th>
            <th scope="col" class="px-4 py-2">Expires</th>
            <th scope="col" class="px-4 py-2">Number</th>
            <th scope="col" class="px-4 py-2">State</th>
            <th scope="col" class="px-4 py-2">Files</th>
            <th scope="col" class="px-4 py-2"><span class="sr-only">Open</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @history.each do |certificate| %>
            <tr id="<%= dom_id(certificate, :history) %>" class="align-top hover:bg-gray-50">
              <td class="whitespace-nowrap px-4 py-2"><%= format_date(certificate.completed_on) %></td>
              <td class="whitespace-nowrap px-4 py-2"><%= certificate.never_expires? ? "Never" : format_date(certificate.expires_on) %></td>
              <td class="whitespace-nowrap px-4 py-2 font-mono text-xs"><%= certificate.certificate_number || dash %></td>
              <td class="px-4 py-2">
                <% if certificate.current? %>
                  <span class="inline-flex rounded-full bg-blue-50 px-2 py-0.5 text-xs font-medium text-blue-700">Current</span>
                <% else %>
                  <span class="text-xs text-gray-500">Replaced <%= format_date(certificate.superseded_at) %></span>
                <% end %>
              </td>
              <td class="px-4 py-2"><%= render "certificates/files", certificate: certificate %></td>
              <td class="whitespace-nowrap px-4 py-2 text-right">
                <%= link_to "View", crew_member_certificate_path(@crew_member, certificate), class: "text-blue-700 hover:underline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
