<%# locals: (certificates:, crew_member:, today:, superseded:) %>
<div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
  <table class="min-w-full divide-y divide-gray-200 text-sm" id="<%= superseded ? "superseded_certificates" : "current_certificates" %>">
    <thead class="bg-gray-50 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
      <tr>
        <th scope="col" class="px-4 py-2">Type</th>
        <th scope="col" class="px-4 py-2">Number</th>
        <th scope="col" class="px-4 py-2">Issued by</th>
        <th scope="col" class="px-4 py-2">Completed</th>
        <th scope="col" class="px-4 py-2">Expires</th>
        <% if superseded %>
          <th scope="col" class="px-4 py-2">Replaced</th>
        <% end %>
        <th scope="col" class="px-4 py-2">Files</th>
        <th scope="col" class="px-4 py-2"><span class="sr-only">Open</span></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% certificates.each do |certificate| %>
        <tr id="<%= dom_id(certificate) %>" class="<%= class_names("align-top hover:bg-gray-50", "text-gray-500": superseded) %>">
          <td class="px-4 py-2">
            <span class="font-medium text-gray-900"><%= certificate.certificate_type.name %></span>
            <span class="block text-xs text-gray-500"><%= certificate.certificate_type.code %></span>
          </td>
          <td class="whitespace-nowrap px-4 py-2 font-mono text-xs"><%= certificate.certificate_number || tag.span("—", class: "font-sans text-gray-400") %></td>
          <td class="px-4 py-2"><%= certificate.issued_by || tag.span("—", class: "text-gray-400") %></td>
          <td class="whitespace-nowrap px-4 py-2"><%= format_date(certificate.completed_on) %></td>
          <td class="whitespace-nowrap px-4 py-2">
            <% if certificate.never_expires? %>
              <span class="text-gray-500">Never</span>
            <% else %>
              <%= format_date(certificate.expires_on) %>
              <% if certificate.expiry_computed? %>
                <span class="text-xs text-gray-400" title="Completed date plus the type's validity">(computed)</span>
              <% elsif certificate.expiry_printed_period? %>
                <span class="text-xs text-gray-400" title="Completed date plus the validity printed on the card">(computed)</span>
              <% end %>
            <% end %>
            <% if !superseded %>
              <span class="ml-1"><%= compliance_badge(Compliance.status_for(certificate, today: today), certificate: certificate) %></span>
            <% elsif certificate.authenticity_confirmed_fake? %>
              <%# Kept as history behind a genuine one (Certificate): still marked, so it isn't mistaken for an old card. %>
              <span class="ml-1"><%= compliance_badge(Compliance.status_for(certificate), certificate: certificate) %></span>
            <% end %>
          </td>
          <% if superseded %>
            <td class="whitespace-nowrap px-4 py-2"><%= format_date(certificate.superseded_at.to_date) %></td>
          <% end %>
          <td class="px-4 py-2"><%= render "certificates/files", certificate: certificate %></td>
          <td class="whitespace-nowrap px-4 py-2 text-right">
            <%= link_to "View", crew_member_certificate_path(crew_member, certificate), class: "text-blue-700 hover:underline",
                  aria: { label: "View #{certificate.certificate_type.name} certificate" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
